# Kopieer dit bestand naar .env en vul in met de gegevens van je eigen Supabase-project
# (Project Settings → API in het Supabase-dashboard).
VITE_SUPABASE_URL=https://jouw-project.supabase.co
VITE_SUPABASE_ANON_KEY=jouw-anon-key

# Meta Ads (alleen in Supabase Edge Function Secrets, NIET in Vercel):
# META_APP_ID=          — Meta Developer App ID
# META_APP_SECRET=      — Meta Developer App Secret
# SITE_URL=             — bv. https://jouw-domein.vercel.app (OAuth redirect terug naar CRM)
